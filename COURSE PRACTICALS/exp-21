#include <stdio.h>

int main() {
    int block[20], process[20], allocation[20];
    int m, n, i, j, worst;

    printf("Enter number of memory blocks: ");
    scanf("%d", &m);

    printf("Enter block sizes:\n");
    for(i = 0; i < m; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter process sizes:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &process[i]);
        allocation[i] = -1;
    }

    for(i = 0; i < n; i++) {
        worst = -1;

        for(j = 0; j < m; j++)
            if(block[j] >= process[i])
                if(worst == -1 || block[j] > block[worst])
                    worst = j;

        if(worst != -1) {
            allocation[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");
    for(i = 0; i < n; i++)
        printf("P%d\t%d\t%s%d\n", i + 1, process[i],
               allocation[i] == -1 ? "Not Allocated" : "B",
               allocation[i] == -1 ? 0 : allocation[i] + 1);

    return 0;
}
