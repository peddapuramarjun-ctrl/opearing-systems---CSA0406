#include <stdio.h>

int main() {
    int n, bt[10], t;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &bt[i]);

    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (bt[i] > bt[j]) {
                t = bt[i];
                bt[i] = bt[j];
                bt[j] = t;
            }

    for (int i = 0; i < n; i++)
        printf("%d ", bt[i]);

    return 0;
}
