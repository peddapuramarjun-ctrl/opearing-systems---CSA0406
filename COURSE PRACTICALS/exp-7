#include <stdio.h>

int main() {
    int bt[5] = {6, 2, 8, 3, 4}, t;

    for (int i = 0; i < 4; i++)
        for (int j = i + 1; j < 5; j++)
            if (bt[i] > bt[j]) {
                t = bt[i];
                bt[i] = bt[j];
                bt[j] = t;
            }

    for (int i = 0; i < 5; i++)
        printf("%d ", bt[i]);

    return 0;
}
