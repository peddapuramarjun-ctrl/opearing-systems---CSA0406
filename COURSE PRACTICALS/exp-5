#include <stdio.h>

int main() {
    int n, pr[10], p[10], temp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Enter Priority for P%d: ", i + 1);
        scanf("%d", &pr[i]);
    }

    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (pr[i] > pr[j]) {
                temp = pr[i];
                pr[i] = pr[j];
                pr[j] = temp;

                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    printf("\nExecution Order:\n");

    for (int i = 0; i < n; i++)
        printf("P%d ", p[i]);

    return 0;
}
