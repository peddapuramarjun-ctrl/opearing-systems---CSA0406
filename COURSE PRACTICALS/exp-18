#include <stdio.h>
#include <string.h>

int main() {
    char files[20][30];
    int n, i;
    char name[30];

    printf("Enter number of files: ");
    scanf("%d",&n);

    printf("Enter file names:\n");
    for(i=0;i<n;i++)
        scanf("%s",files[i]);

    printf("\nFiles in directory:\n");
    for(i=0;i<n;i++)
        printf("%s\n",files[i]);

    printf("\nEnter file to search: ");
    scanf("%s",name);

    for(i=0;i<n;i++)
        if(strcmp(files[i],name)==0) {
            printf("File found\n");
            return 0;
        }

    printf("File not found\n");

    return 0;
}
