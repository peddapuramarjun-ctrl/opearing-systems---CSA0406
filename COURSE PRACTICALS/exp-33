#include <stdio.h>

int main() {
    int p[30], f[10], n,nf,i,j,k,pos,far,idx,found,faults=0;

    printf("Enter number of pages: ");
    scanf("%d",&n);

    printf("Enter reference string: ");
    for(i=0;i<n;i++) scanf("%d",&p[i]);

    printf("Enter number of frames: ");
    scanf("%d",&nf);

    for(i=0;i<nf;i++) f[i]=-1;

    for(i=0;i<n;i++) {
        found=0;

        for(j=0;j<nf;j++)
            if(f[j]==p[i]) found=1;

        if(!found) {
            pos=-1;

            for(j=0;j<nf;j++)
                if(f[j]==-1) {
                    pos=j;
                    break;
                }

            if(pos==-1) {
                far=-1;

                for(j=0;j<nf;j++) {
                    for(k=i+1;k<n;k++)
                        if(f[j]==p[k]) break;

                    if(k>far) {
                        far=k;
                        idx=j;
                    }
                }
                pos=idx;
            }

            f[pos]=p[i];
            faults++;
        }

        printf("%d: ",p[i]);
        for(j=0;j<nf;j++) printf("%d ",f[j]);
        printf("\n");
    }

    printf("Page Faults = %d\n",faults);
    return 0;
}
