#include <stdio.h>

int main()
{
    int pageTable[20];
    int pages, pageSize;
    int logicalAddress;
    int pageNo, offset;
    int frameNo, physical;

    printf("Enter Number of Pages: ");
    scanf("%d", &pages);

    printf("Enter Page Size: ");
    scanf("%d", &pageSize);

    printf("Enter Frame Number for Each Page:\n");
    for (int i = 0; i < pages; i++)
    {
        printf("Page %d: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("Enter Logical Address: ");
    scanf("%d", &logicalAddress);

    pageNo = logicalAddress / pageSize;
    offset = logicalAddress % pageSize;

    if (pageNo >= pages)
    {
        printf("Invalid Logical Address\n");
    }
    else
    {
        frameNo = pageTable[pageNo];
        physical = frameNo * pageSize + offset;

        printf("Page Number = %d\n", pageNo);
        printf("Frame Number = %d\n", frameNo);
        printf("Offset = %d\n", offset);
        printf("Physical Address = %d\n", physical);
    }

    return 0;
}
//OUTPUT
Enter Number of Pages: 4
Enter Page Size: 100
Enter Frame Number for Each Page:
Page 0: 3
Page 1: 1
Page 2: 5
Page 3: 7
Enter Logical Address: 245
Page Number = 2
Frame Number = 5
Offset = 45
Physical Address = 545

