#include <stdio.h>
#include <stdlib.h>

int main() {
    int a[50],n,h,size,i,j,t,total;
    
    printf("Enter disk size: ");
    scanf("%d",&size);
    printf("Enter requests: ");
    scanf("%d",&n);

    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Enter head: ");
    scanf("%d",&h);

    /* Sort */
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j]) {
                t=a[i]; a[i]=a[j]; a[j]=t;
            }

    /* LOOK - right direction */
    total=0;
    printf("\nLOOK: %d",h);

    for(i=0;i<n;i++)
        if(a[i]>=h) {
            total+=abs(h-a[i]);
            h=a[i];
            printf(" -> %d",h);
        }

    for(i=n-1;i>=0;i--)
        if(a[i]<h) {
            total+=abs(h-a[i]);
            h=a[i];
            printf(" -> %d",h);
        }

    printf("\nLOOK movement = %d",total);

    return 0;
}
