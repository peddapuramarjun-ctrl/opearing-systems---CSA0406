#include <stdio.h>
#include <stdlib.h>

int main() {
    int a[50],v[50]={0},n,h,i,j,x,min,p,total;

    printf("Enter number of requests: ");
    scanf("%d",&n);

    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&a[i]);

    printf("Enter head: ");
    scanf("%d",&h);

    /* FCFS */
    x=h; total=0;
    printf("\nFCFS: %d",h);
    for(i=0;i<n;i++) {
        total+=abs(x-a[i]);
        x=a[i];
        printf(" -> %d",x);
    }
    printf("\nSeek time = %d",total);

    /* SSTF */
    x=h; total=0;
    printf("\nSSTF: %d",h);

    for(i=0;i<n;i++) {
        min=9999;
        for(j=0;j<n;j++)
            if(!v[j] && abs(x-a[j])<min) {
                min=abs(x-a[j]);
                p=j;
            }

        v[p]=1;
        total+=min;
        x=a[p];
        printf(" -> %d",x);
    }

    printf("\nSeek time = %d",total);

    return 0;
}
