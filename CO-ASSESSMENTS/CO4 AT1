#include <stdio.h>

int main() {
    int n, f, ch, a[100], i, j, count;

    printf("Enter disk blocks: ");
    scanf("%d", &n);
    printf("Enter file size: ");
    scanf("%d", &f);
    printf("1.Contiguous 2.Linked 3.Indexed: ");
    scanf("%d", &ch);

    for(i=0;i<n;i++) a[i]=0;

    if(ch==1) {
        for(i=0;i<=n-f;i++) {
            count=0;
            for(j=i;j<i+f;j++)
                if(a[j]==0) count++;
            if(count==f) break;
        }

        if(i>n-f)
            printf("Contiguous allocation failed\n");
        else {
            printf("Allocated: ");
            for(j=i;j<i+f;j++) {
                a[j]=1;
                printf("%d ",j);
            }
        }
    }
    else if(ch==2) {
        printf("Allocated: ");
        count=0;
        for(i=0;i<n && count<f;i++)
            if(!a[i]) {
                a[i]=1;
                printf("%d ",i);
                count++;
            }
    }
    else if(ch==3) {
        printf("Index block: 0\nData blocks: ");
        for(i=1;i<=f;i++) {
            a[i]=1;
            printf("%d ",i);
        }
    }

    return 0;
}
